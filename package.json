{
  "name": "crashout-circuit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:clients\"",
    "dev:server": "node --watch --experimental-specifier-resolution=node dist/server/index.js",
    "dev:clients": "vite",
    "build": "npm run build:server && npm run build:clients",
    "build:server": "tsc -p tsconfig.server.json",
    "build:clients": "vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test:acceptance": "tsx scripts/acceptance.ts",
    "test:gestures": "tsx scripts/gestures.ts",
    "test:network": "tsx scripts/network-acceptance.ts",
    "test:visuals": "tsx scripts/visuals.ts",
    "test:tangibles": "tsx scripts/test-tangible-anims.ts",
    "test:autopilot": "tsx scripts/autopilot.ts",
    "test:race-settings": "tsx scripts/race-settings.ts",
    "test:boost": "tsx scripts/boost.ts",
    "test:tangible-touch": "tsx scripts/tangible-touch.ts",
    "verify": "npm run typecheck && npm run test:acceptance && npm run test:gestures && npm run test:network && npm run test:visuals && npm run test:tangibles && npm run test:autopilot && npm run test:boost && npm run test:tangible-touch && npm run test:race-settings && npm run build"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
